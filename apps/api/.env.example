# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://prreviewer:prreviewer_secret@localhost:5432/ai_pr_reviewer

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── GitHub App ────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_BOT_NAME=ai-pr-reviewer

# ── LLM (Anthropic Claude) ───────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
